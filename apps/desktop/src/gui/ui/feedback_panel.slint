import { ScrollView } from "std-widgets.slint";
import { SettingsDialog, SettingsButton } from "settings_controls.slint";
import { SurfaceSeparator, FlatSurface, UiSurface } from "ui_surface.slint";
import { FontAwesomeIcons, ControlStyle } from "common.slint";
import { UiRadius } from "ui_radius.slint";
import { WorkbenchStyle } from "workbench_controls.slint";

export component NavigationGroup inherits FlatSurface {
    height: rows.preferred-height + 2px;
    background: WorkbenchStyle.surface;
    border-radius: UiRadius.control;
    outline-color: UiSurface.edge;
    clip: true;
    rows := VerticalLayout {
        x: 1px; y: 1px; width: parent.width - 2px;
        height: self.preferred-height; padding: 0px; spacing: 0px;
        @children
    }
}

component RowSeparator inherits Rectangle {
    height: 1px;
    SurfaceSeparator {
        x: 14px; width: parent.width - 30px; height: 1px;
        outline-color: UiSurface.separator;
    }
}

component NavigationRow inherits FlatSurface {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <image> logo;
    private property <bool> has-logo: root.logo.width > 0;
    in property <string> detail;
    in property <bool> grouped: false;
    in property <bool> external: false;
    in property <bool> enabled: true;
    callback clicked;
    out property <length> content-width: labels.x + labels.preferred-width + 36px
        + (root.detail != "" ? detail-label.width + 12px : 0px);
    min-width: 0px;
    min-height: max(root.has-logo ? 56px : 44px, labels.preferred-height + 20px);
    background: touch.pressed ? WorkbenchStyle.pressed-surface
        : touch.has-hover ? WorkbenchStyle.hover-surface : WorkbenchStyle.surface;
    border-radius: root.grouped ? 0px : UiRadius.control;
    outline-enabled: !root.grouped; outline-color: UiSurface.edge;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.title + (root.subtitle != "" ? ", " + root.subtitle : "")
        + (root.detail != "" ? ", " + root.detail : "");
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    if root.has-logo: Image {
        x: 12px; y: (parent.height - self.height) / 2;
        width: 44px; height: 44px;
        source: root.logo; image-fit: contain;
        accessible-role: none;
    }
    if !root.has-logo && root.icon != "": Rectangle {
        x: 12px; y: (parent.height - self.height) / 2;
        width: 28px; height: 28px;
        border-radius: UiRadius.control;
        background: ControlStyle.surface;
        Text {
            text: root.icon; font-family: "Font Awesome 6 Free"; font-weight: 900;
            font-size: 13px; color: ControlStyle.icon;
            horizontal-alignment: center; vertical-alignment: center;
            accessible-role: none;
        }
    }
    labels := VerticalLayout {
        x: root.has-logo ? 68px : root.icon != "" ? 52px : 14px;
        y: (parent.height - self.height) / 2;
        width: parent.width - self.x - 36px - (root.detail != "" ? detail-label.width + 12px : 0px);
        height: self.preferred-height; spacing: 4px;
        Text { text: root.title; color: WorkbenchStyle.text; font-size: 13px; wrap: word-wrap; }
        if root.subtitle != "": Text {
            text: root.subtitle; color: WorkbenchStyle.muted; font-size: 11px; wrap: word-wrap;
        }
    }
    detail-label := Text {
        x: parent.width - self.width - 36px; height: parent.height;
        width: min(100px, self.preferred-width);
        text: root.detail; color: WorkbenchStyle.muted; font-size: 11px;
        vertical-alignment: center; overflow: elide;
        accessible-role: none;
    }
    Text {
        x: parent.width - 30px; width: 18px; height: parent.height;
        text: root.external ? FontAwesomeIcons.arrow-up-right-from-square : FontAwesomeIcons.angle-right;
        font-family: "Font Awesome 6 Free"; font-weight: 900;
        color: touch.has-hover ? WorkbenchStyle.accent : WorkbenchStyle.muted;
        font-size: 11px; vertical-alignment: center; horizontal-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export global FeedbackStrings {
    in-out property <string> title: "Feedback & suggestions";
    in-out property <string> github: "Give feedback on GitHub";
    in-out property <string> github-hint: "Report a problem or suggest an improvement.";
    in-out property <string> export: "Export diagnostic logs";
    in-out property <string> export-hint: "Save OneDesk and MiniRTC logs with basic version information as a ZIP file.";
    in-out property <string> exporting: "Exporting…";
    in-out property <string> attachment-hint: "Attach the exported ZIP log archive to your GitHub issue to help us investigate.";
    in-out property <string> close: "Close";
}

export component FeedbackPanel inherits SettingsDialog {
    in property <bool> exporting: false;
    in property <string> status;
    in property <bool> succeeded: false;
    in property <string> saved-path;
    out property <length> preferred-dialog-height: root.content-top
        + content.preferred-height + 16px + footer.preferred-height + 24px;
    callback open-github;
    callback export-logs;
    title: FeedbackStrings.title;
    close-label: FeedbackStrings.close;
    ScrollView {
        x: 24px; y: root.content-top;
        width: parent.width - 48px + 22px;
        height: footer.y - self.y - 16px;
        viewport-width: self.visible-width;
        viewport-height: content.preferred-height;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: as-needed;
        content := VerticalLayout {
            width: parent.width; height: self.preferred-height;
            padding: 0px; padding-right: 22px; spacing: 16px;
            NavigationGroup {
                NavigationRow {
                    grouped: true;
                    title: FeedbackStrings.github;
                    subtitle: FeedbackStrings.github-hint;
                    external: true;
                    clicked => { root.open-github(); }
                }
                RowSeparator { }
                NavigationRow {
                    grouped: true;
                    title: root.exporting ? FeedbackStrings.exporting : FeedbackStrings.export;
                    subtitle: FeedbackStrings.export-hint;
                    enabled: !root.exporting;
                    clicked => { root.export-logs(); }
                }
            }
            Text {
                text: FeedbackStrings.attachment-hint;
                color: WorkbenchStyle.muted;
                font-size: 12px; wrap: word-wrap;
            }
            if root.status != "": Rectangle {
                height: result.preferred-height + 24px;
                background: root.succeeded ? #e9f6ef : #fef2f2;
                border-radius: UiRadius.control;
                result := VerticalLayout {
                    x: 12px; y: 12px; width: parent.width - 24px;
                    height: self.preferred-height; padding: 0px; spacing: 6px;
                    Text {
                        text: root.status;
                        color: root.succeeded ? WorkbenchStyle.success : #b3261e;
                        font-size: 12px; wrap: word-wrap;
                        accessible-role: text;
                    }
                    if root.saved-path != "": Text {
                        text: root.saved-path; color: WorkbenchStyle.muted;
                        font-size: 11px; wrap: char-wrap;
                    }
                }
            }
        }
    }
    footer := VerticalLayout {
        x: 24px; y: parent.height - self.height - 24px;
        width: parent.width - 48px; height: self.preferred-height;
        spacing: 16px;
        SurfaceSeparator { height: 1px; outline-color: UiSurface.separator; }
        HorizontalLayout {
            alignment: end;
            SettingsButton {
                width: max(80px, self.label-width);
                text: FeedbackStrings.close;
                primary: true;
                clicked => { root.close(); }
            }
        }
    }
}
